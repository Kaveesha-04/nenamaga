rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      // For Storage, we can't easily cross-reference Firestore without custom claims.
      // In a real app we'd use Custom Claims set by an Admin SDK script.
      // Here, we check if they are authenticated and we'll secure the path.
      return request.auth != null && request.auth.token.email != null; // Basic check: Admin uses Email/Password, normal users use Anonymous.
    }

    match /artifacts/{appId}/uploads/{allPaths=**} {
      allow read: if true;
      
      // Allow upload if authenticated, file is < 10MB, and is an image or pdf
      allow create: if request.auth != null 
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
                    
      // Allow delete if Admin (authenticated with an email)
      allow delete: if isAdmin();
    }
  }
}
